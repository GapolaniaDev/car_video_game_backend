# Backend environment configuration template.
# Copy this file to `.env` and replace the placeholders with real values
# for local development. NEVER commit a real `.env` to source control.

APP_ENV=development

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# REST API listens on this port INSIDE the Docker network.
# It is exposed to the host only via Nginx on :80.
API_PORT=8080

# Game Server listens on this UDP port (also exposed to host).
GAME_SERVER_PORT=7000

# PostgreSQL connection settings. When running via docker-compose the
# host MUST be "postgres" (the docker-compose service name).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=racing_game
POSTGRES_USER=racing_user
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=disable

# JWT signing secret. Use a long random string in production.
JWT_SECRET=change_me
# JWT issuer string (the `iss` claim).
JWT_ISSUER=racing-game-backend
# Access token lifetime (Go duration syntax: "1h", "30m", …).
JWT_ACCESS_TTL=1h

# Shared HMAC secret between the API and the Game Server for short-
# lived `game_token`s issued on matchmaking. Must differ from
# JWT_SECRET in production.
GAME_TOKEN_SECRET=change_me

# Where the API tells Unity the Game Server is reachable. Defaults
# to "game-server" when running inside the docker network, but
# external clients (Unity on a phone) must override this to the
# public DNS / tunnel host.
GAME_SERVER_PUBLIC_HOST=localhost
GAME_SERVER_PUBLIC_PORT=7000